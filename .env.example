# tgf 环境配置模板（占位值，可安全提交进版本库）
#
# 用法：
#   1. 复制本文件为 .env.<module>，module 取值 dev / test / release。
#        cp .env.example .env.dev
#   2. 把下面的占位值改成你本地/测试/生产环境的真实地址与口令。
#   3. .env.dev / .env.test / .env.release 已被 .gitignore 忽略，真实凭据不会入库。
#
# 框架启动时按 TGFMODULE 环境变量选择加载哪个 .env.<module>，缺省为 dev。
# 示例：TGFMODULE=test go run main.go
#
# 注意：所有口令字段（RedisPassword / MySqlPwd）此处为占位符，
#       严禁把真实生产口令写进本模板并提交。

# ===== 日志 =====
# 日志输出路径
LogPath=./log/tgf.log
# 日志最低输出级别：debug / info / warn / error
LogLevel=info
# 日志忽略标签（逗号分隔），命中的 tag 不输出
LogIgnoredTags=trace,login

# ===== 运行环境 =====
# 当前运行环境标识：dev / test / release
RuntimeModule=dev

# ===== Consul 服务发现 =====
# consul 地址
ConsulAddress=127.0.0.1:8500
# consul 注册路径，多环境共享同一 Consul 时用不同路径隔离（如 /dev /test）
ConsulPath=/tgf

# ===== Redis =====
# redis 地址
RedisAddr=127.0.0.1:6379
# redis 密码（占位值，请改成真实口令）
RedisPassword=CHANGE_ME
# redis 库编号
RedisDB=1

# ===== MySQL =====
# mysql 用户名
MySqlUser=root
# mysql 密码（占位值，请改成真实口令）
MySqlPwd=CHANGE_ME
# mysql 地址
MySqlAddr=127.0.0.1
# mysql 端口
MySqlPort=3306
# mysql 库名
MySqlDB=tgf_game

# ===== 服务 =====
# 当前服务提供的服务端口
ServicePort=8021
# 绑定的服务地址
ServiceAddress=0.0.0.0
# 是否推送用户节点信息到网关，0 关闭 / 1 开启
GatePush=1
