# tgf 测试环境配置模板（占位值，可安全提交）
#
# 用法：复制为 .env.test，填入测试环境真实地址与口令。
#        cp .env.test.example .env.test
# 启动：TGFMODULE=test go run main.go
#
# .env.test 已被 .gitignore 忽略，真实凭据不会入库。

# ===== 日志 =====
LogPath=./log/tgf.log
LogLevel=info
LogIgnoredTags=trace,login

# ===== 运行环境 =====
RuntimeModule=test

# ===== Consul 服务发现 =====
ConsulAddress=127.0.0.1:8500
# 用独立路径隔离测试环境，避免与 dev/release 互相干扰
ConsulPath=/test

# ===== Redis =====
RedisAddr=127.0.0.1:6379
RedisPassword=CHANGE_ME
RedisDB=2

# ===== MySQL =====
MySqlUser=root
MySqlPwd=CHANGE_ME
MySqlAddr=127.0.0.1
MySqlPort=3306
MySqlDB=tgf_game_test

# ===== 服务 =====
ServicePort=8021
ServiceAddress=0.0.0.0
GatePush=1
