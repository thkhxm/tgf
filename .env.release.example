# tgf 生产环境配置模板（占位值，可安全提交）
#
# 用法：复制为 .env.release，填入生产环境真实地址与口令。
#        cp .env.release.example .env.release
# 启动：TGFMODULE=release go run main.go
#
# .env.release 已被 .gitignore 忽略，真实生产凭据绝不入库。
# 生产部署推荐通过容器编排 / 密钥管理（Vault、K8s Secret 等）注入这些值，
# 而不是把口令落到磁盘上的 .env.release 文件里。

# ===== 日志 =====
LogPath=./log/tgf.log
# 生产环境建议 info 或 warn，避免 debug 噪声
LogLevel=info
LogIgnoredTags=trace,login

# ===== 运行环境 =====
RuntimeModule=release

# ===== Consul 服务发现 =====
# 生产 Consul 地址（占位值，请改成真实地址）
ConsulAddress=consul.internal:8500
ConsulPath=/release

# ===== Redis =====
# 生产 Redis 地址（占位值，请改成真实地址）
RedisAddr=redis.internal:6379
# 生产口令必须改成强口令，且通过密钥管理注入，不要明文落盘提交
RedisPassword=CHANGE_ME
RedisDB=0

# ===== MySQL =====
MySqlUser=tgf_prod
# 生产口令必须改成强口令，且通过密钥管理注入
MySqlPwd=CHANGE_ME
MySqlAddr=mysql.internal
MySqlPort=3306
MySqlDB=tgf_game

# ===== 服务 =====
ServicePort=8021
ServiceAddress=0.0.0.0
GatePush=1
